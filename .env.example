# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Clerk
# Browser-safe publishable key used by the TanStack Start Clerk provider
VITE_CLERK_PUBLISHABLE_KEY=
# Server-only key used by Clerk middleware and server helpers
CLERK_SECRET_KEY=

# Set CLERK_JWT_ISSUER_DOMAIN separately in every Convex deployment under
# Settings -> Environment Variables. Do not expose it through a VITE_ variable.

# Feature flags
# Set to "true" to show sign-in / account UI and allow new accounts.
# Omit or set to anything else to keep auth hidden.
VITE_ENABLE_AUTH=
